{
  "name": "@ttrpg-cards/printer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sheet layout, pagination, and PDF generation.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run --passWithNoTests",
    "verify:print": "node scripts/verify-print.ts"
  },
  "dependencies": {
    "@ttrpg-cards/card": "workspace:*",
    "@ttrpg-cards/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pdfjs-dist": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

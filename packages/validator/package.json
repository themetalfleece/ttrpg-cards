{
  "name": "@ttrpg-cards/validator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The single runtime-validation surface for the workspace.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "typebox": "catalog:"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@ttrpg-cards/srd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT AND CC-BY-4.0",
  "description": "Bundled openly-licensed card catalog, extraction, provenance, and attribution.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "extract": "node scripts/extract.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ttrpg-cards/card": "workspace:*",
    "@ttrpg-cards/text": "workspace:*",
    "@ttrpg-cards/validator": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pdfjs-dist": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

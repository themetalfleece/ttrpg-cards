{
  "name": "@ttrpg-cards/importer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Parses user-supplied JSON and Markdown into the card model.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ttrpg-cards/card": "workspace:*",
    "@ttrpg-cards/text": "workspace:*"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
